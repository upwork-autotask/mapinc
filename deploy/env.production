# Production template — copy to C:\mapinc\.env and fill in the CHANGE-ME values.
# With MAPINC_PRODUCTION=true the app refuses to start unless every hardening setting is safe.

MAPINC_DB_HOST=localhost
MAPINC_DB_PORT=5432
MAPINC_DB_NAME=mapinc
MAPINC_DB_USER=mapinc_app
MAPINC_DB_PASSWORD=CHANGE-ME-app
# require = TLS with the self-signed cert from 02-postgresql-hardening.ps1
# verify-full = TLS with a domain-CA certificate; set MAPINC_DB_SSLROOTCERT to the CA .crt
MAPINC_DB_SSLMODE=require
MAPINC_DB_SSLROOTCERT=

# python -c "import secrets; print(secrets.token_urlsafe(48))"
MAPINC_SECRET_KEY=CHANGE-ME
MAPINC_ALLOWED_HOSTS=letters.CHANGE-ME.local
MAPINC_DEBUG=false
MAPINC_PDF_CONVERTER=word
MAPINC_WORD_TIMEOUT_SECONDS=60

MAPINC_PRODUCTION=true
MAPINC_HTTPS=true
MAPINC_BEHIND_PROXY=true
MAPINC_AUTH_MODE=remote_user
MAPINC_SESSION_MINUTES=30
MAPINC_LOCKOUT_FAILURES=5
MAPINC_LOCKOUT_MINUTES=15
MAPINC_ALLOW_QUERY_PREFILL=false
# only PCs on the office LAN may create handoff links
MAPINC_HANDOFF_ALLOWED_NETWORKS=192.168.1.0/24
MAPINC_HANDOFF_MINUTES=5
