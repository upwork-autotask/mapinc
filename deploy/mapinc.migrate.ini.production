; Used ONLY for schema migrations, with the owner role:
;   set MAPINC_INI=C:\mapinc\mapinc.migrate.ini
;   python manage.py migrate
; Keep this file readable by Administrators only (it holds the owner password).

[database]
host = localhost
port = 5432
name = mapinc
user = mapinc_owner
password = CHANGE-ME-owner
sslmode = require
sslrootcert =

[app]
secret_key = CHANGE-ME-same-as-mapinc.ini
allowed_hosts = letters.CHANGE-ME.local
debug = false
production = true
https = true
behind_proxy = true
auth_mode = remote_user
allow_query_prefill = false
