; Production template — copy to C:\mapinc\mapinc.ini and fill in the CHANGE-ME values.
; With production = true the app refuses to start unless every hardening setting is safe.

[database]
host = localhost
port = 5432
name = mapinc
user = mapinc_app
password = CHANGE-ME-app
; require = TLS with the self-signed cert from 02-postgresql-hardening.ps1
; verify-full = TLS with a domain-CA certificate; set sslrootcert to the CA .crt
sslmode = require
sslrootcert =

[app]
; python -c "import secrets; print(secrets.token_urlsafe(48))"
secret_key = CHANGE-ME
allowed_hosts = letters.CHANGE-ME.local
debug = false
pdf_converter = word
word_timeout_seconds = 60

production = true
https = true
behind_proxy = true
auth_mode = remote_user
session_minutes = 30
lockout_failures = 5
lockout_minutes = 15
allow_query_prefill = false
; only PCs on the office LAN may create handoff links
handoff_allowed_networks = 192.168.1.0/24
handoff_minutes = 5
