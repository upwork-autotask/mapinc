# Used ONLY for schema migrations, with the owner role:
#   $env:MAPINC_ENV_FILE = "C:\mapinc\.env.migrate"; python manage.py migrate; Remove-Item Env:MAPINC_ENV_FILE
# Copy to C:\mapinc\.env.migrate and keep it readable by Administrators only (it holds the owner password).

MAPINC_DB_HOST=localhost
MAPINC_DB_PORT=5432
MAPINC_DB_NAME=mapinc
MAPINC_DB_USER=mapinc_owner
MAPINC_DB_PASSWORD=CHANGE-ME-owner
MAPINC_DB_SSLMODE=require
MAPINC_DB_SSLROOTCERT=

MAPINC_SECRET_KEY=CHANGE-ME-same-as-.env
MAPINC_ALLOWED_HOSTS=letters.CHANGE-ME.local
MAPINC_DEBUG=false
MAPINC_PRODUCTION=true
MAPINC_HTTPS=true
MAPINC_BEHIND_PROXY=true
MAPINC_AUTH_MODE=remote_user
MAPINC_ALLOW_QUERY_PREFILL=false
