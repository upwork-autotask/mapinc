[database]
host = localhost
port = 5432
name = mapinc
user = mapinc
password = mapinc
; require / verify-ca / verify-full in production; prefer is fine for a dev PC
sslmode = prefer
; path to the CA certificate when sslmode = verify-ca / verify-full
sslrootcert =

[app]
secret_key = change-me-to-a-long-random-string
allowed_hosts = *
debug = true
pdf_converter = word          ; word | libreoffice
word_timeout_seconds = 60

; ---- HIPAA hardening (see docs/hipaa-hardening-plan.md) ----
; production = true makes the app refuse to start unless every setting below is safe
production = false
; true once IIS (or another TLS proxy) serves the app over HTTPS
https = false
; true when IIS forwards X-Forwarded-Proto / X-Forwarded-For
behind_proxy = false
; open        = letter form needs no login (dev only)
; login       = letter form requires an app login
; remote_user = IIS Windows Authentication supplies the user (X-Remote-User header)
auth_mode = open
; automatic logoff after this many idle minutes
session_minutes = 30
; lock an account after this many failed sign-ins, for this many minutes
lockout_failures = 5
lockout_minutes = 15
; allow ?member_name=... style prefill in the URL (dev/testing only; launchers use handoff tokens)
allow_query_prefill = true
; who may call /letter/handoff/ (comma-separated CIDRs; empty = anyone)
handoff_allowed_networks =
; how long a handoff link stays valid
handoff_minutes = 5
