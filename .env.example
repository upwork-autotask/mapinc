# mapinc configuration — copy to .env and edit. Real environment variables override this file.
# Never commit .env (it is git-ignored).

# --- PostgreSQL ---
MAPINC_DB_HOST=localhost
MAPINC_DB_PORT=5432
MAPINC_DB_NAME=mapinc
MAPINC_DB_USER=mapinc
MAPINC_DB_PASSWORD=mapinc
# prefer on a dev PC; require / verify-ca / verify-full in production
MAPINC_DB_SSLMODE=prefer
# CA certificate path when sslmode is verify-ca / verify-full
MAPINC_DB_SSLROOTCERT=

# --- Application ---
MAPINC_SECRET_KEY=change-me-to-a-long-random-string
MAPINC_ALLOWED_HOSTS=*
MAPINC_DEBUG=true
# word | libreoffice
MAPINC_PDF_CONVERTER=word
MAPINC_WORD_TIMEOUT_SECONDS=60

# --- HIPAA hardening (see docs/hipaa-hardening-plan.md) ---
# true on the live server: the app refuses to start unless every setting below is safe
MAPINC_PRODUCTION=false
# true once IIS (or another TLS proxy) serves the app over HTTPS
MAPINC_HTTPS=false
# true when IIS forwards X-Forwarded-Proto / X-Forwarded-For
MAPINC_BEHIND_PROXY=false
# open = no login for the letter form (dev) | login = app login | remote_user = IIS Windows Authentication
MAPINC_AUTH_MODE=open
# automatic logoff after this many idle minutes
MAPINC_SESSION_MINUTES=30
# lock an account after this many failed sign-ins, for this many minutes
MAPINC_LOCKOUT_FAILURES=5
MAPINC_LOCKOUT_MINUTES=15
# allow ?member_name=... prefill in the URL (dev/testing only; launchers use handoff tokens)
MAPINC_ALLOW_QUERY_PREFILL=true
# "Open folder" may start Explorer on the server, but only for a browser on the server itself
MAPINC_LOCAL_EXPLORER=true
# URL scheme registered on staff PCs so remote browsers can open the folder too
# (see deploy/open-folder); empty = copy the path to the clipboard instead
MAPINC_FOLDER_PROTOCOL=
# where letters may be written (comma-separated full paths; empty = anywhere the launcher asks)
MAPINC_ALLOWED_FOLDER_ROOTS=
# who may call /letter/handoff/ (comma-separated CIDRs; empty = anyone)
MAPINC_HANDOFF_ALLOWED_NETWORKS=
# how long a handoff link stays valid
MAPINC_HANDOFF_MINUTES=5
